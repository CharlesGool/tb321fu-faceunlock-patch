# 这些变量在 TB321FU-GSI-Mods 的 devices/<设备>/conf.d/faceunlock.conf 中设置, 同名环境变量优先.
# services.jar 编译 (构建镜像时)
FU_D2J=
FU_R8=
FU_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# 编 FaceUnlock.apk 和 FaceUnlockSettingsOverlay.apk (构建镜像前, 本地)
D2J=
R8=
APKTOOL=
BT=
KOTLIN_HOME=
FACEUNLOCK_KEYSTORE=
PARANOIDSENSE_DIR=
